# Copy to .env and fill in. Never commit .env.
DEV_MODE=false

# Set to false to disable POST /auth/signup entirely (family/private deployments: the one account is
# created by hand, new users are added via POST /auth/users by an owner). Defaults to true for local dev.
ALLOW_PUBLIC_SIGNUP=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts each user's Gemini API key. Changing it makes stored keys unreadable (users must re-enter them).
CREDENTIALS_ENCRYPTION_KEY=

# Platform admins (comma-separated emails): the only users allowed on /api/v1/admin/* (agroai_admin panel).
# They log in with their normal user; everyone else gets a 404 on those routes.
PLATFORM_ADMIN_EMAILS=

CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Server-side key for current weather (https://openweathermap.org/api). Gemini keys are per user (BYOK).
OPENWEATHER_API_KEY=

# Server-side key for web search (https://tavily.com), shared across the app — not BYOK, since search
# shouldn't compete with each user's own Gemini quota.
TAVILY_API_KEY=

# Optional: zone-level satellite signal (NDVI/NDWI, Sentinel-2). Free tier, register a client at
# https://dataspace.copernicus.eu — without these, get_zone_satellite_status reports "not configured"
# instead of failing.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Optional model overrides
# Chat (agent back-and-forth) — lite; a chat turn with a photo uses GEMINI_MODEL's chain instead.
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_CHAT_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash
# Analysis (photos, satellite/layout images, expert data analysis)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_LITE_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview

# SMN forecast batch (worker service)
SMN_INTERVAL_HOURS=6
SMN_HOURLY_STEP=3

# Compose
POSTGRES_USER=agroai
POSTGRES_PASSWORD=agroai
POSTGRES_DB=agroai
DB_PORT=54321
API_PORT=8000

# Knowledge base: which core/ reference documents ride in EVERY request (system prompt). Unset or "none" (default) = only the
# ~1.3k-token knowledge map; the references are on-demand skills (core-*) that the agent loads for the turn that needs them.
# A comma-separated list of numeric prefixes of src/agent/knowledge_base/core/ (e.g. "01,03") pins those documents in the
# prompt; "all" pins all of them (~115k tokens re-sent on every step of the agent loop: only for paid tiers that prefer it).
# KNOWLEDGE_CORE_ALWAYS=01,03

# Gemini caching and reasoning for the chat agent.
# Explicit context caching bills storage per token-hour and is not available on the free tier; leave it off and rely on
# Gemini's automatic implicit caching unless every conversation makes many model calls per hour.
# GEMINI_EXPLICIT_CACHE=false
# Reasoning depth of the chat agent (Gemini 3): minimal | low | medium | high. Reasoning tokens are billed as output.
# GEMINI_CHAT_THINKING_LEVEL=low
# Leave unset to use the model default (1.0, recommended by Google for Gemini 3).
# GEMINI_CHAT_TEMPERATURE=

# Preflight: before the chat model answers, a cheap router call picks the skills and read-only tools the message needs, they
# run in parallel, and the model answers once with everything in hand (instead of one model call per skill or tool). It falls
# back to the plain agent loop if the router fails. Turn it off to compare cost and quality.
# AGENT_PREFLIGHT=true
# Cap, in estimated tokens (~4 chars each), on the knowledge + data the preflight puts in front of the model.
# AGENT_PREFLIGHT_MAX_TOKENS=60000
# A stored NDVI/NDWI reading at most this many hours old answers the agent without a new Copernicus call (credits).
# SATELLITE_MAX_AGE_HOURS=12

# Crop analyses (diagnosis, periodic and zone tracking): after the first pass, if it found something worth it (a risk, a disease,
# low confidence), search the web on it and refine the analysis at the highest reasoning depth. A request can force it either way
# with {"deep": true|false}. Costs a second, longer model call plus a few searches (needs TAVILY_API_KEY).
# ANALYSIS_DEEP=true
