# Copy to .env and fill in. Never commit .env.
DEV_MODE=false

# Set to false to disable POST /auth/signup entirely (family/private deployments: the one account is
# created by hand, new users are added via POST /auth/users by an owner). Defaults to true for local dev.
ALLOW_PUBLIC_SIGNUP=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts each user's Gemini API key. Changing it makes stored keys unreadable (users must re-enter them).
CREDENTIALS_ENCRYPTION_KEY=

# Platform admins (comma-separated emails): the only users allowed on /api/v1/admin/* (agroai_admin panel).
# They log in with their normal user; everyone else gets a 404 on those routes.
PLATFORM_ADMIN_EMAILS=

CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Server-side key for current weather (https://openweathermap.org/api). Gemini keys are per user (BYOK).
OPENWEATHER_API_KEY=

# Server-side key for web search (https://tavily.com), shared across the app — not BYOK, since search
# shouldn't compete with each user's own Gemini quota.
TAVILY_API_KEY=

# Optional: satellite time series per field (Sentinel-2 NDVI/NDRE/NDMI/EVI/NDWI + Sentinel-1 radar). Free
# tier (10,000 processing units/month), register a client at https://dataspace.copernicus.eu — without
# these, get_zone_satellite_status reports "not configured" instead of failing.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Scheduled ingest (`satellite` compose service). Keep it off until the real cost per field is measured:
#   python -m src.scripts.copernicus_measure --field-id <a real field>
SATELLITE_INGEST_ENABLED=false
# SATELLITE_INTERVAL_HOURS=24
# SATELLITE_BACKFILL_YEARS=3
# SATELLITE_BATCH_PU_BUDGET=7000       # monthly processing units for the scheduled job
# SATELLITE_ON_DEMAND_PU_BUDGET=2000   # monthly processing units for user-facing refreshes and NDVI maps
# SATELLITE_MIN_VALID_FRACTION=0.6     # passes with less cloud-free surface don't enter the analysis
# SATELLITE_S1_ENABLED=true
# SATELLITE_S1_ORBIT_DIRECTION=DESCENDING

# Optional model overrides
# Chat (agent back-and-forth) — lite; a chat turn with a photo uses GEMINI_MODEL's chain instead.
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_CHAT_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash
# Analysis (photos, satellite/layout images, expert data analysis)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_LITE_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview

# SMN forecast batch (worker service)
SMN_INTERVAL_HOURS=6
SMN_HOURLY_STEP=3

# Compose
POSTGRES_USER=agroai
POSTGRES_PASSWORD=agroai
POSTGRES_DB=agroai
DB_PORT=54321
API_PORT=8000
