# Copy to .env and fill in. Never commit .env.
DEV_MODE=false

# Set to false to disable POST /auth/signup entirely (family/private deployments: the one account is
# created by hand, new users are added via POST /auth/users by an owner). Defaults to true for local dev.
ALLOW_PUBLIC_SIGNUP=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts each user's Gemini API key. Changing it makes stored keys unreadable (users must re-enter them).
CREDENTIALS_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Server-side key for current weather (https://openweathermap.org/api). Gemini keys are per user (BYOK).
OPENWEATHER_API_KEY=

# Server-side key for web search (https://tavily.com), shared across the app — not BYOK, since search
# shouldn't compete with each user's own Gemini quota.
TAVILY_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_LITE_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview

# SMN forecast batch (worker service)
SMN_INTERVAL_HOURS=6
SMN_HOURLY_STEP=3

# Compose
POSTGRES_USER=agroai
POSTGRES_PASSWORD=agroai
POSTGRES_DB=agroai
DB_PORT=54321
API_PORT=8000
