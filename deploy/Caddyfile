api.167-172-135-217.nip.io {
	# JSON access log, read by fail2ban on the host (deploy/fail2ban). Caddy redacts Authorization and
	# Cookie headers in it by default. Rotated by Caddy itself: 5 files of 10 MiB at most.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The API only returns JSON and images: nothing in a response may run scripts or be framed.
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}
	reverse_proxy api:8000
}
