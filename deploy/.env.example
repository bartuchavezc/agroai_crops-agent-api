# Copy to .env on the droplet (in this same deploy/ directory) and fill in. Never commit it.
DEV_MODE=false

# Private family deployment: nobody can self-register. The one account is created by hand once, every
# other user is added via POST /auth/users (owner-only "add member") from the web app's profile screen.
ALLOW_PUBLIC_SIGNUP=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Your own email(s), comma-separated: the only users who can read /api/v1/admin/* (agroai_admin panel). The
# panel calls the API from its server, so it doesn't need to be in CORS_ORIGINS.
PLATFORM_ADMIN_EMAILS=

# The Vercel production URL goes here once it exists (comma-separated if more than one origin).
CORS_ORIGINS=https://api.167-172-135-217.nip.io
APP_TIMEZONE=America/Argentina/Buenos_Aires

OPENWEATHER_API_KEY=
TAVILY_API_KEY=

# Optional: zone-level satellite signal (NDVI/NDWI, Sentinel-2). Free tier, register a client at
# https://dataspace.copernicus.eu — without these, get_zone_satellite_status reports "not configured".
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

SMN_HOURLY_STEP=3

# Compose (a strong, unique password — this is not exposed to the internet, only reachable from the
# api/migrate/worker containers on the internal compose network)
POSTGRES_USER=agroai
POSTGRES_PASSWORD=
POSTGRES_DB=agroai
